{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "discord-announcement-email-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "A Cloudflare Worker that emails verified Discord announcement crossposts.",
  "keywords": [
    "cloudflare-workers",
    "discord",
    "email",
    "resend"
  ],
  "homepage": "https://github.com/mynameistito/discord-announcement-email-bridge#readme",
  "bugs": {
    "url": "https://github.com/mynameistito/discord-announcement-email-bridge/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mynameistito/discord-announcement-email-bridge.git"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "bun scripts/e2e.ts",
    "knip": "knip",
    "check": "ultracite check",
    "format": "ultracite fix",
    "build": "bun build src/worker.ts --target=browser --outdir=dist",
    "dev": "alchemy dev",
    "deploy": "alchemy deploy",
    "fix": "ultracite fix",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@distilled.cloud/discord": "1.0.0-rc.13",
    "@distilled.cloud/resend": "1.0.0-rc.13",
    "alchemy": "2.0.0-beta.80",
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261004.1",
    "@effect/platform-bun": "4.0.0",
    "@effect/platform-node": "4.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-jsdoc": "^65.1.0",
    "eslint-plugin-sonarjs": "^4.2.1",
    "eslint-plugin-tsdoc": "^0.5.2",
    "knip": "6.39.0",
    "lefthook": "^2.1.16",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "ultracite": "7.12.2",
    "vitest": "5.0.3"
  },
  "packageManager": "bun@1.4.2"
}
