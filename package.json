{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "discord-announcement-email-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "A Cloudflare Worker that emails verified Discord announcement crossposts.",
  "keywords": [
    "cloudflare-workers",
    "discord",
    "email",
    "resend"
  ],
  "homepage": "https://github.com/mynameistito/discord-announcement-email-bridge#readme",
  "bugs": {
    "url": "https://github.com/mynameistito/discord-announcement-email-bridge/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mynameistito/discord-announcement-email-bridge.git"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsrs --noEmit && tsrs --noEmit -p scripts/tsconfig.json && tsrs --noEmit -p __tests__/e2e/tsconfig.json",
    "test": "vitest run",
    "e2e": "bun scripts/e2e.ts",
    "knip": "knip",
    "check": "ultracite check",
    "format": "ultracite fix",
    "build": "bun build src/worker.ts --target=browser --outdir=dist",
    "dev": "alchemy dev",
    "deploy": "alchemy deploy",
    "fix": "ultracite fix",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@distilled.cloud/discord": "1.0.0-rc.18",
    "@distilled.cloud/resend": "1.0.0-rc.18",
    "alchemy": "2.0.0-beta.85",
    "effect": "4.1.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261106.1",
    "@effect/platform-bun": "4.1.2",
    "@effect/platform-node": "4.1.2",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-jsdoc": "^65.4.4",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-tsdoc": "^0.5.4",
    "knip": "6.44.1",
    "lefthook": "^2.2.2",
    "miniflare": "^4.20260730.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2006",
    "tsrs": "0.22.0-ts7.1.0-beta",
    "ultracite": "8.1.1",
    "vitest": "5.1.0"
  },
  "packageManager": "bun@1.4.4"
}
