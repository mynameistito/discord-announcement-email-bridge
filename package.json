{
  "name": "discord-announcement-email-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "ultracite check",
    "format": "ultracite fix",
    "build": "bun build src/worker.ts --target=browser --outdir=dist",
    "dev": "alchemy dev",
    "deploy": "alchemy deploy",
    "fix": "ultracite fix",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@effect/sql-d1": "4.0.0",
    "alchemy": "2.0.0-beta.80",
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260926.1",
    "@effect/platform-bun": "4.0.0",
    "@effect/platform-node": "4.0.0",
    "@types/bun": "1.4.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-sonarjs": "^4.2.1",
    "lefthook": "^2.1.16",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "ultracite": "7.12.2",
    "vitest": "5.0.2"
  },
  "packageManager": "bun@1.4.2"
}
